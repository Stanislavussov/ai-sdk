{
  "name": "ai-sdk",
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "clean": "rm -rf dist schema.json *.tsbuildinfo",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "build": "npm run clean && npm run generate:schema && tsc",
    "prepare": "npm run generate:schema && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@sinclair/typebox": "*",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@sinamtz/pi-minimax-provider": "^1.0.13",
    "@types/node": "^25.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
